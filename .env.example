# Hosted Sites supplies authenticated ChatGPT user identity.
# The public landing/install/demo are anonymous; financial API requires sign-in.
# Never add database credentials, passwords, tokens or financial backups here.
# Local mock identity is development-only. Independent hosting must replace
# app/chatgpt-auth.ts with verified origin-side authentication before exposure.

# Set these as hosted runtime variables after creating your Supabase Auth project.
# Leave AUTH_MODE unset/platform until email delivery and templates are ready.
AUTH_MODE=platform
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
